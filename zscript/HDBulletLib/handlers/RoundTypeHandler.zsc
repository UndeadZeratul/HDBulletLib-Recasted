            unspentName:      'HDUnSpentSlug',
            fumbledName:      'HDFumblingSlug',
            casingName:       'SlugBrass',
            singlePickupName: 'HDFumblingSlug',
            bundlePickupName: 'SlugPickup',
            boxPickupName:    'SlugBoxPickup',
            bundleAmt:        4,
            boxAmt:           20,
            singleSprite:     "SLG1A0",
            bundleSprite:     "SLUGA0",
            boxSprite:        "SLBXA0" //,
            // numProjectiles:   1
        ));

        // Thunder Rocket
        registerRoundType('ThunderRocket', HDBLRoundType.create(
            'WAN_ThuRKTAmmo', 'WAN_ThuRKT',
            // spentName:        'None',
            // unspentName:      'None',
            // fumbledName:      'None',
            // casingName:       'None',
            // singlePickupName: 'None',
            // bundlePickupName: 'None',
            // boxPickupName:    'None',
            // bundleAmt:        -1,
            // boxAmt:           -1,
            singleSprite:     "THRKB0" //,
            // bundleSprite:     "",
            // boxSprite:        "",
            // numProjectiles:   1
        ));

        // Tortoise Rocket
        registerRoundType('TortoiseRocket', HDBLRoundType.create(
            'WAN_TortRKTAmmo', 'WAN_TortRKT',
            // spentName:        'None',
            // unspentName:      'None',
            // fumbledName:      'None',
            // casingName:       'None',
            // singlePickupName: 'None',
            // bundlePickupName: 'None',
            // boxPickupName:    'None',
            // bundleAmt:        -1,
            // boxAmt:           -1,
            singleSprite:     "TRTRB0" //,
            // bundleSprite:     "",
            // boxSprite:        "",
            // numProjectiles:   1
        ));
    }

    override void NetworkProcess(ConsoleEvent e) {
        Array<string> splitNames;
        e.name.split(splitNames, ":");

        // If we haven't been given a valid command, quit.
        if (splitNames.size() < 2) return;

        // If the player who emitted the event is not in game, quit.
        if (!playerInGame[e.player]) return;

        // Get the PlayerPawn of the player who emitted the event.
        let plr = players[e.player].mo;

        // If that PlayerPawn doesn't exist, quit.
        if (!plr) return;

        // If we don't have one, log & quit.
        if (!roundTypes.checkKey(splitNames[1])) {
            HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' is not registered.");
            return;
        }

        // Get the desired RoundType registered with this handler.
        let roundType = roundTypes.get(splitNames[1]);

        // If the desired RoundType is invalid, quit.
        if (!roundType) return;

        name eventName = splitNames[0];
        switch (eventName) {
            case 'HDBL_LogRoundType': {
                console.printF(roundType.toString());
                break;
            }
            case 'HDBL_FireRound': {

                if (!(Class<Actor>)(roundType.projName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid projName: \'"..roundType.projName.."\'.");
                    break;
                }

                roundType.fireRound(
                    plr,
                    spread: e.isManual ? e.args[0] : 0,
                    speedFactor: e.isManual ? e.args[1] : 0,
                    amount: e.isManual ? e.args[2] : 1
                );

                break;
            }
            case 'HDBL_EjectRoundSpent': {

                if (!(Class<Actor>)(roundType.spentName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid spentName: \'"..roundType.spentName.."\'.");
                    break;
                }

                roundType.ejectRoundSpent(
                    plr,
                    e.args[0],
                    ejectVel: (Actor.angleToVector(e.args[0], e.args[1]), 0)
                );

                break;
            }
            case 'HDBL_EjectRoundUnSpent': {

                if (!(Class<Actor>)(roundType.unSpentName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid unSpentName: \'"..roundType.unSpentName.."\'.");
                    break;
                }

                roundType.ejectRoundUnSpent(
                    plr,
                    e.args[0],
                    ejectVel: (Actor.angleToVector(e.args[0], e.args[1]), 0)
                );

                break;
            }
            case 'HDBL_EjectRoundFumbled': {

                if (!(Class<Actor>)(roundType.fumbledName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid fumbledName: \'"..roundType.fumbledName.."\'.");
                    break;
                }

                roundType.ejectRoundFumbled(
                    plr,
                    e.args[0],
                    ejectVel: (Actor.angleToVector(e.args[0], e.args[1]), 0)
                );

                break;
            }
            case 'HDBL_SpawnRoundAmmo': {

                if (!(Class<Actor>)(roundType.ammoName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid ammoName: \'"..roundType.ammoName.."\'.");
                    break;
                }

                roundType.spawnAmmo(
                    plr.pos + HDMath.getGunPos(plr),
                    e.args[0]
                );

                break;
            }
            case 'HDBL_SpawnRoundSpent': {

                if (!(Class<Actor>)(roundType.spentName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid spentName: \'"..roundType.spentName.."\'.");
                    break;
                }

                let max = max(1, e.args[0]);
                for (let i = 0; i < max; i++) {
                    Actor.spawn(
                        roundType.spentName,
                        plr.pos + HDMath.getGunPos(plr)
                    );
                }

                break;
            }
            case 'HDBL_SpawnRoundUnSpent': {

                if (!(Class<Actor>)(roundType.unSpentName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid unSpentName: \'"..roundType.unSpentName.."\'.");
                    break;
                }

                let max = max(1, e.args[0]);
                for (let i = 0; i < max; i++) {
                    let r = Actor.spawn(
                        roundType.unSpentName,
                        plr.pos + HDMath.getGunPos(plr)
                    );
                    r.target = plr;
                }

                break;
            }
            case 'HDBL_SpawnRoundFumbled': {

                if (!(Class<Actor>)(roundType.fumbledName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid fumbledName: \'"..roundType.fumbledName.."\'.");
                    break;
                }

                let max = max(1, e.args[0]);
                for (let i = 0; i < max; i++) {
                    Actor.spawn(
                        roundType.fumbledName,
                        plr.pos + HDMath.getGunPos(plr)
                    );
                }

                break;
            }
            case 'HDBL_SpawnRoundCasing': {

                if (!(Class<Actor>)(roundType.casingName)) {
                    HDBL.logWarn('HDBulletLib', "RoundType \'"..splitNames[1].."\' has an invalid casingName: \'"..roundType.casingName.."\'.");
                    break;
                }

                let max = max(1, e.args[0]);
                for (let i = 0; i < max; i++) {
                    Actor.spawn(
                        roundType.casingName,
                        plr.pos + HDMath.getGunPos(plr)
                    );
                }

                break;
            }
            default: {
                break;
            }
        }
    }

    void registerRoundType(name roundName, HDBLRoundType roundType, bool replace = false) {

        // If the round type is null, quit.
        if (!roundType) return;

        // If we already have something registered and we're not replacing it, quit.
        if (roundTypes.checkKey(roundName) && !replace) return;

        roundTypes.insert(roundName, roundType);
    }
}